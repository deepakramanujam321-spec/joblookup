# GitHub Actions secrets (repo Settings -> Secrets and variables -> Actions)
# -- see README.md "Setup". Not read from this file by anything.

DATABASE_URL=            # Supabase -> Connect -> Session pooler URI
BRAVE_API_KEY=           # https://api.search.brave.com/app/keys

# LLM via LiteLLM: set ONE provider key (LLM_MODEL optional, auto-detected)
OPENAI_API_KEY=
# ANTHROPIC_API_KEY= / GEMINI_API_KEY= / GROQ_API_KEY=
# LLM_MODEL=openai/gpt-4o-mini
# MAX_LLM_CALLS_PER_RUN=60

# Digest email (Gmail app password: https://myaccount.google.com/apppasswords)
GMAIL_ADDRESS=
GMAIL_APP_PASSWORD=
# or SMTP_HOST / SMTP_PORT / SMTP_USERNAME / SMTP_PASSWORD
# DASHBOARD_URL=https://<your-render-host>   # adds "Open in JobLookup" links
