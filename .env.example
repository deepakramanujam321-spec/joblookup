# These are GitHub Actions secrets (repo Settings -> Secrets and variables
# -> Actions), not local env vars -- see README.md "Setup". Listed here only
# so it's obvious what to name each one; this file itself is never read by
# any script. db/.env.example covers the separate DATABASE_URL needed only
# for running Alembic migrations.

# Brave Search API — https://api.search.brave.com/app/keys (free tier: 2000 queries/month)
BRAVE_API_KEY=

# LLM for scoring fit + drafting outreach notes (scripts/score_and_draft.py),
# via LiteLLM -- provider-agnostic. Pick a model, set the matching key below,
# leave the others blank. Full provider list: docs.litellm.ai/docs/providers
#   anthropic/claude-sonnet-5        -> ANTHROPIC_API_KEY (default if LLM_MODEL unset)
#   openai/gpt-4o-mini               -> OPENAI_API_KEY
#   gemini/gemini-2.0-flash          -> GEMINI_API_KEY
#   groq/llama-3.3-70b-versatile     -> GROQ_API_KEY (fast, generous free tier)
LLM_MODEL=
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GEMINI_API_KEY=
GROQ_API_KEY=

# Supabase — project tssyakhdwewofhzcmxdj, schema `jobseeker`. The service-role
# key bypasses RLS, so treat it like a database password.
SUPABASE_URL=https://tssyakhdwewofhzcmxdj.supabase.co
SUPABASE_SERVICE_ROLE_KEY=

# SMTP for sending the weekend digest. Defaults to Gmail (smtp.gmail.com) --
# use an App Password there, not your normal password:
# https://myaccount.google.com/apppasswords (requires 2-Step Verification).
# Any other provider works too: set SMTP_HOST/SMTP_PORT and use
# SMTP_USERNAME/SMTP_PASSWORD instead of the Gmail-specific names.
GMAIL_ADDRESS=
GMAIL_APP_PASSWORD=
# SMTP_HOST=
# SMTP_PORT=
# SMTP_USERNAME=
# SMTP_PASSWORD=
