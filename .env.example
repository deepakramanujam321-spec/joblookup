# Copy this to the environment's configured env vars (not into git).
# See README.md "Setup" for where these are set in Claude Code on the web.

# Brave Search API — https://api.search.brave.com/app/keys (free tier: 2000 queries/month)
BRAVE_API_KEY=

# Gmail SMTP for sending the weekend digest. Use an App Password, not your
# normal password: https://myaccount.google.com/apppasswords
# (requires 2-Step Verification enabled on the account)
GMAIL_ADDRESS=deepakramanujam321@gmail.com
GMAIL_APP_PASSWORD=

# Supabase — Routine-fired sessions have no MCP connectors available, so
# storage goes over plain REST using the service-role key (bypasses RLS,
# which is intentionally policy-less on this table — see README.md).
# Project: deepakramanujam321-spec's Project (tssyakhdwewofhzcmxdj)
# Get the key from: Supabase dashboard -> this project -> Project Settings
# -> API -> "service_role" secret (click reveal). Treat it like a password —
# it bypasses every RLS policy in the project.
SUPABASE_URL=https://tssyakhdwewofhzcmxdj.supabase.co
SUPABASE_SERVICE_ROLE_KEY=
