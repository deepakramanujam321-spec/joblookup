# Local dev for the dashboard. In production these are Render env vars.
DATABASE_URL=postgresql+psycopg://postgres@localhost:5432/joblookup
DASHBOARD_USERNAME=
DASHBOARD_PASSWORD=

# Resume storage: "local" (FILE_STORAGE_DIR) or Supabase Storage (default when both below are set)
FILE_STORAGE=local
# SUPABASE_URL=https://<ref>.supabase.co
# SUPABASE_SERVICE_ROLE_KEY=

# Draft generation / resume extraction (any LiteLLM provider key)
# OPENAI_API_KEY=

# Optional Google integrations -- README.md "Google integrations"
# TOKEN_ENCRYPTION_KEY=any-long-random-string
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# GOOGLE_API_KEY=
# GOOGLE_APP_ID=
# PUBLIC_BASE_URL=http://localhost:8000
